---
import * as fs from "node:fs";
import * as path from "node:path";

import { footerConfig, profileConfig } from "../../../config";
import { url } from "../../../utils/url-utils";

const currentYear = new Date().getFullYear();

// 页脚自定义内容逻辑
let customFooterHtml = "";
if (footerConfig.enable) {
	// 优先使用 customHtml，如果为空则使用 FooterConfig.html 文件内容
	if (footerConfig.customHtml && footerConfig.customHtml.trim() !== "") {
		customFooterHtml = footerConfig.customHtml.trim();
	} else {
		// customHtml 为空时，读取 FooterConfig.html 文件内容
		try {
			const footerConfigPath = path.join(
				process.cwd(),
				"src",
				"FooterConfig.html",
			);
			customFooterHtml = fs.readFileSync(footerConfigPath, "utf-8");
			// 移除HTML注释
			customFooterHtml = customFooterHtml
				.replace(/<!--[\s\S]*?-->/g, "")
				.trim();
		} catch (error) {
			console.warn(
				"FooterConfig.html文件读取失败:",
				error instanceof Error ? error.message : error,
			);
		}
	}
}
---

<!--<div class="border-t border-[var(--primary)] mx-16 border-dashed py-8 max-w-[var(--page-width)] flex flex-col items-center justify-center px-6">-->
<div
	class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"
>
</div>
<!--<div class="transition bg-[oklch(92%_0.01_var(--hue))] dark:bg-black rounded-2xl py-8 mt-4 mb-8 flex flex-col items-center justify-center px-6">-->
<div
	class="transition border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6"
>
	<div class="transition text-50 text-sm text-center">
		{customFooterHtml && <div class="mb-2" set:html={customFooterHtml} />}

		<div class="mb-2">
			&copy; <span id="copyright-year">{currentYear}</span>
			{profileConfig.name}. All Rights Reserved. /
			{/*
				🔴 主题原版这里指向 `rss/` 和 `atom/`，期望存在 /rss/ 与 /atom/ 两个页面。
				但本站在线实测 /rss 与 /atom 都是 404，真实 feed 是 /rss.xml 与 /atom.xml。
				改成直链，并且**去掉 navigateToPage**（那是 Swup 站内跳转，
				会把 .xml 当页面容器去 fetch，反而报错）。
			*/}
			<a
				class="transition link text-[var(--primary)] font-medium"
				href="/rss.xml"
				>RSS</a
			> /
			<a
				class="transition link text-[var(--primary)] font-medium"
				href="/atom.xml"
				>Atom</a
			> /
			<a
				class="transition link text-[var(--primary)] font-medium"
				target="_blank"
				href={url("sitemap-index.xml")}>Sitemap</a
			>
		</div>

		<div>
			Powered by
			<a
				class="transition link text-[var(--primary)] font-medium"
				target="_blank"
				href="https://astro.build">Astro</a
			> &
			<a
				class="transition link text-[var(--primary)] font-medium"
				target="_blank"
				href="https://github.com/LyraVoid/Mizuki">Mizuki</a
			>&nbsp; Version <a
				class="transition link text-[var(--primary)] font-medium"
				target="_blank"
				href="https://github.com/LyraVoid/Mizuki">9.0</a
			>
		</div>
	</div>

	<!-- 百度统计：站点流量统计 -->
	<script is:inline data-swup-ignore-script>
		(function () {
			// 百度统计站点 ID
			var BAIDU_HM_ID = "84bd24fadddaf817ea0c0082174e8808";

			window._hmt = window._hmt || [];

			// 1. 加载 hm.js。页脚在桌面端与移动端各渲染一次，
			//    用全局标记保证 hm.js 全站只加载一次。
			if (!window.__baiduHmLoaded) {
				window.__baiduHmLoaded = true;
				var hm = document.createElement("script");
				hm.async = true;
				hm.src = "https://hm.baidu.com/hm.js?" + BAIDU_HM_ID;
				var firstScript = document.getElementsByTagName("script")[0];
				if (firstScript && firstScript.parentNode) {
					firstScript.parentNode.insertBefore(hm, firstScript);
				} else {
					document.head.appendChild(hm);
				}
			}

			// 2. 本站用 Swup 做无刷新跳转，切页不会重新加载 hm.js，
			//    必须手动补报一次 PV，否则一次访问只会统计到进入的第一个页面。
			//    page:view 只在跳转时触发，首次加载由 hm.js 自行统计，不会重复计数。
			if (window.__baiduPvHooked) {
				return;
			}
			window.__baiduPvHooked = true;

			document.addEventListener("swup:page:view", function (event) {
				try {
					var args = event && event.detail && event.detail.args;
					var path =
						(args && args.url) ||
						window.location.pathname + window.location.search;
					window._hmt.push(["_trackPageview", path]);
				} catch (error) {
					// 统计失败不影响页面正常使用
				}
			});
		})();
	</script>
</div>
